{
  "name": "realworldproblems-portal",
  "private": true,
  "packageManager": "yarn@1.22.22",
  "workspaces": [
    "api"
  ],
  "scripts": {
    "start": "ng serve --open",
    "build": "ng build",
    "build:portal": "ng build",
    "api:start": "yarn workspace realworldproblems-portal-api start",
    "api:build": "yarn workspace realworldproblems-portal-api build",
    "api:test": "yarn workspace realworldproblems-portal-api test",
    "swa:build": "yarn build:portal && yarn api:build",
    "swa:provision": "azd provision",
    "swa:deploy": "azd deploy",
    "swa:up": "azd up",
    "swa:deploy:script": "pwsh -File ./scripts/deploy-swa.ps1",
    "test": "yarn api:test"
  },
  "dependencies": {
    "@angular/animations": "^18.2.0",
    "@angular/common": "^18.2.0",
    "@angular/compiler": "^18.2.0",
    "@angular/core": "^18.2.0",
    "@angular/forms": "^18.2.0",
    "@angular/platform-browser": "^18.2.0",
    "@angular/router": "^18.2.0",
    "rxjs": "^7.8.1",
    "tslib": "^2.6.3",
    "zone.js": "^0.14.10"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^18.2.0",
    "@angular/cli": "^18.2.0",
    "@angular/compiler-cli": "^18.2.0",
    "@types/node": "^20.14.12",
    "typescript": "5.5.4"
  }
}